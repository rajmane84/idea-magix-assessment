# Copy this file to .env and fill in the values below.
# This is also the file docker-compose.yml and `docker run --env-file` read from
# when starting the backend in a container - see README for both Docker methods.

# --- Server ---
PORT=5000
NODE_ENV=development
# Public base URL of this server, used to build links to locally-stored files
# (STORAGE_DRIVER=local). Defaults to http://localhost:$PORT if unset - set this
# to your real public URL (e.g. your Render URL, or http://localhost:5000 for Docker) in production.
SERVER_URL=
# Base URL of the frontend, used to build links back to the app (e.g. in emails).
CLIENT_URL=http://localhost:3000

# --- Database ---
# Use host.docker.internal instead of localhost/127.0.0.1 if the backend is running
# in a plain Docker container and MongoDB is on your host machine.
MONGODB_URI=mongodb://127.0.0.1:27017/prescripto

# --- Auth ---
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d

# --- Email (OTP verification) ---
# Dev: emails are sent through a Nodemailer Ethereal sandbox account created automatically
# at startup - no credentials needed, a preview link is printed to the console per email.
# Prod: required - create an API key at https://resend.com
EMAIL_FROM=Prescripto <onboarding@resend.dev>
RESEND_API_KEY=

# --- Storage (profile images + prescription PDFs) ---
# "local"  - writes files to disk under STORAGE_LOCAL_DIR, served from /uploads.
#            Used in production on Render, and the default for plain `docker run`.
# "s3"     - writes files to an S3-compatible bucket (MinIO via docker-compose locally,
#            or any real S3-compatible provider). Requires the S3_* vars below.
#            docker-compose.yml overrides STORAGE_DRIVER and the S3_* vars automatically
#            to point at its bundled MinIO service - see README for the docker-compose setup.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads

# Only required when STORAGE_DRIVER=s3.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true
