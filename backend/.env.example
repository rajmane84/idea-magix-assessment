PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/prescripto
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
NODE_ENV=development
# Public base URL of this server, used to build links to locally-stored files
# (STORAGE_DRIVER=local). Defaults to http://localhost:$PORT if unset - set this
# to your real public URL (e.g. your Render URL) in production.
SERVER_URL=

# Email (OTP verification)
# Dev: emails are sent through a Nodemailer Ethereal sandbox account created automatically
# at startup - no credentials needed, a preview link is printed to the console per email.
# Prod: required - create an API key at https://resend.com
EMAIL_FROM=Prescripto <onboarding@resend.dev>
RESEND_API_KEY=

# Storage (profile images + prescription PDFs)
# "local"  - writes files to disk under STORAGE_LOCAL_DIR, served from /uploads.
#            Used in production on Render, since docker-compose isn't available there.
# "s3"     - writes files to an S3-compatible bucket (MinIO via docker-compose locally,
#            or any real S3-compatible provider). Requires the S3_* vars below.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads

# Only required when STORAGE_DRIVER=s3. docker-compose.yml wires these up automatically
# for the local MinIO service - see README for the docker-compose setup.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true
