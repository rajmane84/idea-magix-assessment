PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/prescripto
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Email (OTP verification)
# Dev: emails are sent through a Nodemailer Ethereal sandbox account created automatically
# at startup - no credentials needed, a preview link is printed to the console per email.
# Prod: required - create an API key at https://resend.com
EMAIL_FROM=Prescripto <onboarding@resend.dev>
RESEND_API_KEY=

# Cloudinary (profile image storage)
# Create an account at https://cloudinary.com and grab these from the dashboard.
# All uploads are stored under CLOUDINARY_FOLDER/profiles so they stay isolated
# from anything else in the same Cloudinary account.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=prescripto
